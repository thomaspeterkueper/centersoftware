# Neon PostgreSQL connection string. Never commit the real value.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Generate a long random secret (minimum 32 characters) for every environment.
BETTER_AUTH_SECRET=replace-with-a-long-random-secret

# Local development URL. Set this to the production origin on Vercel.
BETTER_AUTH_URL=http://localhost:3000
