# Neon PostgreSQL connection string. Never commit the real value.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Generate a long random secret (minimum 32 characters) for every environment.
BETTER_AUTH_SECRET=replace-with-a-long-random-secret

# Local development URL. Set this to the production origin on Vercel.
BETTER_AUTH_URL=http://localhost:3000

# Only this address may create the first account during the bootstrap phase.
INITIAL_OWNER_EMAIL=owner@example.com

# Initial center created for the configured owner after the first successful sign-in.
INITIAL_CENTER_CODE=main
INITIAL_CENTER_NAME=Centersoftware
